{
  "palette": [ "ctrl+k", "alt+k" ],
  "settings.open": "ctrl+,",
  "tab.new": "ctrl+t",
  "tab.close": "ctrl+w",
  "tab.next": [ "ctrl+tab", "ctrl+pagedown" ],
  "tab.previous": [ "ctrl+shift+tab", "ctrl+pageup" ],
  "url.edit": "ctrl+l",
  "find": "ctrl+shift+f",
  "page.reload": "ctrl+r",
  "page.back": "ctrl+[",
  "page.forward": "ctrl+]",
  "devtools.toggle": [ "ctrl+shift+i", "f12" ],
  "devtools.console": "ctrl+alt+j",
  "record.toggle": "ctrl+shift+r",
  "grab.toggle": "ctrl+g",
  "zoom.in": "ctrl+=",
  "zoom.out": "ctrl+-",
  "zoom.reset": "ctrl+0",
  "ui.zoom.in": "ctrl+shift+=",
  "ui.zoom.out": "ctrl+shift+-",
  "ui.zoom.reset": "ctrl+shift+0",
  "quit": "ctrl+q"
}
